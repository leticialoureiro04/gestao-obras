@model GestaoObras.Models.Cliente
@{
    ViewData["Title"] = "Criar Cliente";
}

@* 
    View: Criar Cliente
    Finalidade: Formulário para criação de novos clientes no sistema.
    Notas: Usa AdminLTE, validação server-side + client-side.
*@

<!-- Header da página -->
<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">
                    <i class="fas fa-user-plus mr-2"></i>Criar Cliente
                </h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item">
                        <a asp-action="Index" asp-controller="Home">Dashboard</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-action="Index">Clientes</a>
                    </li>
                    <li class="breadcrumb-item active">Criar</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<!-- Conteúdo principal -->
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">

                <div class="card card-primary">
                    <!-- Título do card -->
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-user-plus mr-2"></i>Novo Cliente
                        </h3>

                        <div class="card-tools">
                            <a asp-action="Index" class="btn btn-tool" title="Ver lista">
                                <i class="fas fa-list"></i>
                            </a>
                        </div>
                    </div>

                    <!-- Formulário -->
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div class="card-body">
                            <!-- Resumo de validação -->
                            <div asp-validation-summary="ModelOnly"
                                 class="alert alert-danger"
                                 role="alert"></div>

                            <div class="row">

                                <!-- Coluna Esquerda -->
                                <div class="col-md-6">

                                    <!-- Nome -->
                                    <div class="form-group">
                                        <label asp-for="Nome">
                                            <i class="fas fa-user mr-1"></i>Nome Completo
                                        </label>

                                        <div class="input-group">
                                            <span class="input-group-text">
                                                <i class="fas fa-user"></i>
                                            </span>
                                            <input asp-for="Nome" class="form-control"
                                                   placeholder="Ex: João Silva" autofocus />
                                        </div>

                                        <span asp-validation-for="Nome" class="text-danger small"></span>
                                    </div>

                                    <!-- NIF -->
                                    <div class="form-group">
                                        <label asp-for="NIF">
                                            <i class="fas fa-id-card mr-1"></i>NIF
                                        </label>

                                        <div class="input-group">
                                            <span class="input-group-text">
                                                <i class="fas fa-id-card"></i>
                                            </span>
                                            <input asp-for="NIF" class="form-control"
                                                   placeholder="Ex: 123456789" maxlength="9" />
                                        </div>

                                        <span asp-validation-for="NIF" class="text-danger small"></span>
                                    </div>

                                    <!-- Morada -->
                                    <div class="form-group">
                                        <label asp-for="Morada">
                                            <i class="fas fa-map-marker-alt mr-1"></i>Morada
                                        </label>

                                        <div class="input-group">
                                            <span class="input-group-text">
                                                <i class="fas fa-map-marker-alt"></i>
                                            </span>
                                            <input asp-for="Morada" class="form-control"
                                                   placeholder="Ex: Rua das Flores, nº 12, Coimbra" />
                                        </div>

                                        <span asp-validation-for="Morada" class="text-danger small"></span>
                                    </div>
                                </div>

                                <!-- Coluna Direita -->
                                <div class="col-md-6">

                                    <!-- Email -->
                                    <div class="form-group">
                                        <label asp-for="Email">
                                            <i class="fas fa-envelope mr-1"></i>Email
                                        </label>

                                        <div class="input-group">
                                            <span class="input-group-text">
                                                <i class="fas fa-envelope"></i>
                                            </span>
                                            <input asp-for="Email" type="email" class="form-control"
                                                   placeholder="exemplo@email.com" />
                                        </div>

                                        <span asp-validation-for="Email" class="text-danger small"></span>
                                    </div>

                                    <!-- Telefone -->
                                    <div class="form-group">
                                        <label asp-for="Telefone">
                                            <i class="fas fa-phone mr-1"></i>Telefone
                                        </label>

                                        <div class="input-group">
                                            <span class="input-group-text">
                                                <i class="fas fa-phone"></i>
                                            </span>
                                            <input asp-for="Telefone" class="form-control"
                                                   placeholder="Ex: 912345678" maxlength="9" />
                                        </div>

                                        <span asp-validation-for="Telefone" class="text-danger small"></span>
                                    </div>

                                    <!-- Caixa de informação -->
                                    <div class="callout callout-success">
                                        <h5>
                                            <i class="fas fa-info-circle"></i> Dica
                                        </h5>
                                        <p class="mb-0">
                                            Preencha todos os campos para criar um novo cliente no sistema.
                                        </p>
                                    </div>

                                </div>
                            </div>
                        </div>

                        <!-- Rodapé -->
                        <div class="card-footer">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save mr-2"></i>Guardar
                            </button>

                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-times mr-2"></i>Cancelar
                            </a>
                        </div>

                    </form>
                </div>

            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(function () {

            // Máscara para NIF
            $('#NIF').on('input', function () {
                this.value = this.value.replace(/\D/g, '').substring(0, 9);
            });

            // Máscara para Telefone
            $('#Telefone').on('input', function () {
                this.value = this.value.replace(/\D/g, '').substring(0, 9);
            });

            // Feedback visual ao submeter o formulário
            $('form').on('submit', function () {
                var btn = $(this).find('button[type="submit"]');
                btn.prop('disabled', true);
                btn.html('<i class="fas fa-spinner fa-spin mr-2"></i>A guardar...');
            });

            // Focus automático
            $('input[autofocus]').focus();
        });
    </script>
}



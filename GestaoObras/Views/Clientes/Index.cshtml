@model IEnumerable<GestaoObras.Models.Cliente>
@{
    ViewData["Title"] = "Lista de Clientes";

    // Verificar rapidamente se existem clientes
    var hasItems = Model != null && Model.Any();
}

@*
    View: Lista de Clientes
    Finalidade: Mostrar todos os clientes com ações rápidas (ver/editar/apagar).
    Notas: layout AdminLTE + tabela responsiva + estados vazios.
*@

<!-- Header da página -->
<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">

            <div class="col-sm-6">
                <h1 class="m-0">
                    <i class="fas fa-users mr-2"></i>Clientes
                </h1>
            </div>

            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item">
                        <a asp-action="Index" asp-controller="Home">Dashboard</a>
                    </li>
                    <li class="breadcrumb-item active">Clientes</li>
                </ol>
            </div>

        </div>
    </div>
</div>

<!-- Conteúdo principal -->
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">

                <div class="card card-primary card-outline">

                    <!-- Header -->
                    <div class="card-header">
                        <h3 class="card-title">Lista de Clientes</h3>
                        <div class="card-tools">
                            <a asp-action="Create" class="btn btn-primary btn-sm">
                                <i class="fas fa-user-plus mr-1"></i> Novo Cliente
                            </a>
                        </div>
                    </div>

                    <!-- Corpo -->
                    <div class="card-body p-0">

                        @if (!hasItems)
                        {
                            <!-- Estado vazio -->
                            <div class="p-4">
                                <div class="alert alert-info mb-0">
                                    <h5><i class="icon fas fa-info-circle"></i> Informação</h5>
                                    Ainda não existem clientes no sistema.
                                    <a asp-action="Create" class="alert-link">Criar o primeiro</a>.
                                </div>
                            </div>
                        }
                        else
                        {
                            <!-- Tabela -->
                            <div class="table-responsive">
                                <table class="table table-hover table-striped mb-0">
                                    <thead class="thead-light">
                                        <tr>
                                            <th>Nome</th>
                                            <th style="width:140px;">NIF</th>
                                            <th>Email</th>
                                            <th style="width:140px;">Telefone</th>
                                            <th style="width:180px;" class="text-right">Ações</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @foreach (var item in Model)
                                        {
                                            <tr>

                                                <!-- Nome -->
                                                <td>
                                                    <i class="fas fa-user-circle mr-1"></i>
                                                    <strong>@item.Nome</strong>
                                                </td>

                                                <!-- NIF -->
                                                <td>@item.NIF</td>

                                                <!-- Email -->
                                                <td>
                                                    @if (!string.IsNullOrEmpty(item.Email))
                                                    {
                                                        <a href="mailto:@item.Email">
                                                            <i class="fas fa-envelope mr-1"></i>@item.Email
                                                        </a>
                                                    }
                                                </td>

                                                <!-- Telefone -->
                                                <td>
                                                    @if (!string.IsNullOrEmpty(item.Telefone))
                                                    {
                                                        <a href="tel:@item.Telefone">
                                                            <i class="fas fa-phone mr-1"></i>@item.Telefone
                                                        </a>
                                                    }
                                                </td>

                                                <!-- Botões de ação -->
                                                <td class="text-right">
                                                    <div class="btn-group">

                                                        <a asp-action="Details"
                                                           asp-route-id="@item.Id_Cliente"
                                                           class="btn btn-info btn-sm"
                                                           title="Ver detalhes">
                                                            <i class="fas fa-eye"></i>
                                                        </a>

                                                        <a asp-action="Edit"
                                                           asp-route-id="@item.Id_Cliente"
                                                           class="btn btn-warning btn-sm"
                                                           title="Editar">
                                                            <i class="fas fa-edit"></i>
                                                        </a>

                                                        <a asp-action="Delete"
                                                           asp-route-id="@item.Id_Cliente"
                                                           class="btn btn-danger btn-sm"
                                                           title="Apagar">
                                                            <i class="fas fa-trash-alt"></i>
                                                        </a>

                                                    </div>
                                                </td>

                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                    </div>

                    <!-- Rodapé (apenas quando existem clientes) -->
                    @if (hasItems)
                    {
                        <div class="card-footer clearfix">
                            <small class="text-muted">
                                Total: <strong>@Model.Count()</strong> cliente(s)
                            </small>
                        </div>
                    }

                </div>

            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $(function () {
            // Ativar tooltips para os botões
            $('[title]').tooltip();
        });
    </script>
}




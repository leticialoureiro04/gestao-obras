@model GestaoObras.Models.Material

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"
     style="display:@((ViewData.ModelState?.ErrorCount ?? 0) > 0 ? "block" : "none")"></div>

<div class="form-group">
    <label asp-for="Nome"></label>
    <div class="input-group">
        <div class="input-group-prepend">
            <span class="input-group-text"><i class="fas fa-box"></i></span>
        </div>
        <input asp-for="Nome" class="form-control" />
    </div>
    <span asp-validation-for="Nome" class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="Descricao"></label>
    <textarea asp-for="Descricao" class="form-control" rows="3"></textarea>
    <span asp-validation-for="Descricao" class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="Stock_Disponivel"></label>
    <div class="input-group">
        <div class="input-group-prepend">
            <span class="input-group-text"><i class="fas fa-layer-group"></i></span>
        </div>
        <input asp-for="Stock_Disponivel" class="form-control" type="number" min="0" />
    </div>
    <span asp-validation-for="Stock_Disponivel" class="text-danger"></span>
</div>

@model GestaoObras.Models.Material
@{
    ViewData["Title"] = "Detalhes do Material";
}

@*
    View: Detalhes do Material
    Objetivo: Mostrar informação completa do material num layout organizado com AdminLTE.
    Notas:
    - Mantém coerência visual com todas as páginas de detalhes.
    - Suporte para tabs, caso futuramente sejam adicionadas mais secções.
*@

<!-- Header da página -->
<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">

            <div class="col-sm-6">
                <h1 class="m-0">
                    <i class="fas fa-box mr-2"></i>Detalhes do Material: @Model.Nome
                </h1>
            </div>

            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item">
                        <a asp-action="Index" asp-controller="Home">Dashboard</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-action="Index" asp-controller="Materiais">Materiais</a>
                    </li>
                    <li class="breadcrumb-item active">Detalhes</li>
                </ol>
            </div>

        </div>
    </div>
</div>

<!-- Conteúdo principal -->
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">

                <div class="card card-primary card-outline card-outline-tabs">

                    <!-- Tabs -->
                    <div class="card-header p-0 border-bottom-0">
                        <ul class="nav nav-tabs" id="materialTabs" role="tablist">
                            <li class="nav-item">
                                <a class="nav-link active" id="dados-tab" data-toggle="pill"
                                   href="#dados" role="tab" aria-selected="true">
                                    <i class="fas fa-info-circle mr-1"></i> Dados Gerais
                                </a>
                            </li>
                        </ul>
                    </div>

                    <!-- Conteúdo das tabs -->
                    <div class="card-body">
                        <div class="tab-content" id="materialTabContent">

                            <!-- TAB: Dados -->
                            <div class="tab-pane fade show active" id="dados" role="tabpanel">
                                <div class="row">
                                    <div class="col-md-8">

                                        <h5 class="border-bottom pb-2 mb-3">
                                            <i class="fas fa-box text-primary mr-2"></i>Informações do Material
                                        </h5>

                                        <dl class="row">
                                            <dt class="col-sm-3">Nome</dt>
                                            <dd class="col-sm-9"><strong>@Model.Nome</strong></dd>

                                            <dt class="col-sm-3">Descrição</dt>
                                            <dd class="col-sm-9">@Model.Descricao</dd>

                                            <dt class="col-sm-3">Stock</dt>
                                            <dd class="col-sm-9">
                                                <span class="badge badge-info p-2">
                                                    <i class="fas fa-cubes mr-1"></i>
                                                    @Model.Stock_Disponivel
                                                </span>
                                            </dd>
                                        </dl>

                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>

                    <!-- Rodapé -->
                    <div class="card-footer">

                        <a asp-action="Edit" asp-route-id="@Model.Id_Material" class="btn btn-warning">
                            <i class="fas fa-edit mr-1"></i> Editar
                        </a>

                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left mr-1"></i> Voltar
                        </a>

                        <a asp-action="Delete" asp-route-id="@Model.Id_Material" class="btn btn-danger float-right">
                            <i class="fas fa-trash-alt mr-1"></i> Apagar
                        </a>

                    </div>

                </div>

            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $(function () {

            // Controla mudança de tabs
            $('#materialTabs a[data-toggle="pill"]').on('click', function (e) {
                e.preventDefault();
                $(this).tab('show');
            });

            // Guarda aba ativa no hash da URL
            $('a[data-toggle="pill"]').on('shown.bs.tab', function (e) {
                window.location.hash = e.target.getAttribute('href');
            });

            // Reabre a última tab via hash
            var hash = window.location.hash;
            if (hash) {
                $('#materialTabs a[href="' + hash + '"]').tab('show');
            }

        });
    </script>
}



@using System.Globalization
@model GestaoObras.Models.Obra
@{
    ViewData["Title"] = "Detalhes da Obra";
}

@*
    View: Detalhes da Obra
    Objetivo: Visualização completa da obra com abas para dados gerais,
              materiais, mão de obra e pagamentos.
    Notas:
    - Estrutura organizada por tabs.
    - Evita repetição de componentes e segue estilo AdminLTE.
*@

<!-- Header da página -->
<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">

            <div class="col-sm-6">
                <h1 class="m-0">
                    <i class="fas fa-building mr-2"></i>Detalhes da Obra: @Model.Nome
                </h1>
            </div>

            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Obras</a></li>
                    <li class="breadcrumb-item active">Detalhes</li>
                </ol>
            </div>

        </div>
    </div>
</div>

<!-- Conteúdo principal -->
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">

                <!-- Card principal com tabs -->
                <div class="card card-primary card-outline card-outline-tabs">

                    <!-- Tabs -->
                    <div class="card-header p-0 border-bottom-0">
                        <ul class="nav nav-tabs" id="obraTabs" role="tablist">
                            <li class="nav-item">
                                <a class="nav-link active" id="dados-tab" data-toggle="pill" href="#dados" role="tab">
                                    <i class="fas fa-info-circle mr-1"></i> Dados Gerais
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="material-tab" data-toggle="pill" href="#material" role="tab">
                                    <i class="fas fa-box mr-1"></i> Registo de Material
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="maoobra-tab" data-toggle="pill" href="#maoobra" role="tab">
                                    <i class="fas fa-hard-hat mr-1"></i> Mão de Obra
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="pagamentos-tab" data-toggle="pill" href="#pagamentos" role="tab">
                                    <i class="fas fa-euro-sign mr-1"></i> Pagamentos
                                </a>
                            </li>
                        </ul>
                    </div>

                    <!-- Conteúdo das Tabs -->
                    <div class="card-body">
                        <div class="tab-content" id="obraTabContent">

                            <!-- TAB: Dados Gerais -->
                            <div class="tab-pane fade show active" id="dados" role="tabpanel">
                                <div class="row">

                                    <!-- Coluna esquerda -->
                                    <div class="col-md-6">
                                        <h5 class="border-bottom pb-2 mb-3">
                                            <i class="fas fa-building text-primary mr-2"></i>Informações da Obra
                                        </h5>
                                        <dl class="row">
                                            <dt class="col-sm-4">Nome</dt>
                                            <dd class="col-sm-8"><strong>@Model.Nome</strong></dd>

                                            <dt class="col-sm-4">Descrição</dt>
                                            <dd class="col-sm-8">@Model.Descricao</dd>

                                            <dt class="col-sm-4">Cliente</dt>
                                            <dd class="col-sm-8">
                                                <a asp-controller="Clientes" asp-action="Details" asp-route-id="@Model.Cliente?.Id_Cliente">
                                                    <i class="fas fa-user mr-1"></i>@Model.Cliente?.Nome
                                                </a>
                                            </dd>

                                            <dt class="col-sm-4">Morada</dt>
                                            <dd class="col-sm-8">
                                                <i class="fas fa-map-marker-alt mr-1"></i>@Model.Morada
                                            </dd>

                                            <dt class="col-sm-4">Ativa</dt>
                                            <dd class="col-sm-8">
                                                @if (Model.Ativa)
                                                {
                                                    <span class="badge badge-success"><i class="fas fa-check"></i> Sim</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-secondary"><i class="fas fa-times"></i> Não</span>
                                                }
                                            </dd>
                                        </dl>
                                    </div>

                                    <!-- Coluna direita -->
                                    <div class="col-md-6">
                                        <h5 class="border-bottom pb-2 mb-3">
                                            <i class="fas fa-map-marked-alt text-success mr-2"></i>Localização
                                        </h5>

                                        <dl class="row">
                                            <dt class="col-sm-4">Latitude</dt>
                                            <dd class="col-sm-8">@Model.Latitude?.ToString("0.######", CultureInfo.InvariantCulture)</dd>

                                            <dt class="col-sm-4">Longitude</dt>
                                            <dd class="col-sm-8">@Model.Longitude?.ToString("0.######", CultureInfo.InvariantCulture)</dd>
                                        </dl>

                                        @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
                                        {
                                            <div class="text-center mt-3">
                                                <a href="https://www.google.com/maps?q=@Model.Latitude,@Model.Longitude"
                                                   target="_blank"
                                                   class="btn btn-sm btn-outline-primary">
                                                    <i class="fas fa-external-link-alt mr-1"></i> Abrir no Google Maps
                                                </a>
                                            </div>
                                        }
                                    </div>

                                </div>
                            </div>

                            <!-- TAB: Registo de Material -->
                            <div class="tab-pane fade" id="material" role="tabpanel">
                                <!-- Formulário de movimento -->
                                <div class="card card-success">
                                    <div class="card-header">
                                        <h3 class="card-title"><i class="fas fa-plus-circle mr-2"></i>Adicionar Material</h3>
                                    </div>
                                    <div class="card-body">

                                        <form asp-controller="Movimentos" asp-action="Create" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="Id_Obra" value="@Model.Id_Obra" />

                                            <div class="form-group">
                                                <label><i class="fas fa-box mr-1"></i>Material</label>
                                                <select name="Id_Material" class="form-control select2" required>
                                                    <option value="">Selecione...</option>
                                                    @{
                                                        var mats = ViewData["Materiais"] as List<GestaoObras.Models.Material>;
                                                        if (mats != null)
                                                        {
                                                            foreach (var m in mats)
                                                            {
                                                                <option value="@m.Id_Material">@m.Nome (Stock: @m.Stock_Disponivel)</option>
                                                            }
                                                        }
                                                    }
                                                </select>
                                            </div>

                                            <div class="form-group">
                                                <label><i class="fas fa-calculator mr-1"></i>Quantidade</label>
                                                <input type="number" name="Quantidade" class="form-control" step="0.01" required />
                                            </div>

                                            <button class="btn btn-success">
                                                <i class="fas fa-save mr-1"></i> Registar Material
                                            </button>
                                        </form>
                                    </div>
                                </div>

                                <!-- Tabela de movimentos -->
                                <div class="card card-primary mt-3">
                                    <div class="card-header">
                                        <h3 class="card-title"><i class="fas fa-list mr-2"></i>Materiais Registados</h3>
                                    </div>
                                    <div class="card-body p-0">

                                        @if (Model.Movimentos?.Any() == true)
                                        {
                                            <div class="table-responsive">
                                                <table class="table table-striped table-hover mb-0">
                                                    <thead class="thead-light">
                                                        <tr>
                                                            <th>Material</th>
                                                            <th class="text-center">Operação</th>
                                                            <th class="text-center">Quantidade</th>
                                                            <th>Data</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var mov in Model.Movimentos.OrderByDescending(m => m.Data_Operacao))
                                                        {
                                                            var add = mov.Operacao.Equals("ADD", StringComparison.OrdinalIgnoreCase);
                                                            <tr>
                                                                <td><strong>@mov.Material?.Nome</strong></td>

                                                                <td class="text-center">
                                                                    @if (add)
                                                                    {
                                                                        <span class="badge badge-success"><i class="fas fa-plus"></i> ADD</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="badge badge-danger"><i class="fas fa-minus"></i> REMOVE</span>
                                                                    }
                                                                </td>

                                                                <td class="text-center">
                                                                    <strong class="@(add ? "text-success" : "text-danger")">
                                                                        @mov.Quantidade
                                                                    </strong>
                                                                </td>

                                                                <td>
                                                                    <i class="far fa-clock mr-1"></i>@mov.Data_Operacao.ToString("dd/MM/yyyy HH:mm")
                                                                </td>

                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="p-3 text-center text-muted">
                                                <i class="fas fa-info-circle mr-1"></i>Não há materiais registados.
                                            </div>
                                        }

                                    </div>
                                </div>

                            </div>

                            <!-- TAB: Mão de Obra -->
                            <div class="tab-pane fade" id="maoobra" role="tabpanel">

                                <!-- Formulário -->
                                <div class="card card-warning">
                                    <div class="card-header">
                                        <h3 class="card-title"><i class="fas fa-plus-circle mr-2"></i>Adicionar Mão de Obra</h3>
                                    </div>
                                    <div class="card-body">

                                        <form asp-controller="MaoDeObra" asp-action="Create" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="Id_Obra" value="@Model.Id_Obra" />

                                            <div class="form-group">
                                                <label><i class="fas fa-user mr-1"></i>Nome</label>
                                                <input type="text" name="NomePessoa" class="form-control" required />
                                            </div>

                                            <div class="form-group">
                                                <label><i class="fas fa-clock mr-1"></i>Horas</label>
                                                <input type="number" name="HorasTrabalhadas" step="0.5" class="form-control" required />
                                            </div>

                                            <button class="btn btn-warning">
                                                <i class="fas fa-save mr-1"></i> Registar
                                            </button>
                                        </form>

                                    </div>
                                </div>

                                <!-- Lista -->
                                <div class="card card-primary mt-3">
                                    <div class="card-header">
                                        <h3 class="card-title"><i class="fas fa-list mr-2"></i>Registos de Mão de Obra</h3>
                                    </div>
                                    <div class="card-body p-0">

                                        @if (Model.MaoDeObra?.Any() == true)
                                        {
                                            <div class="table-responsive">
                                                <table class="table table-striped table-hover mb-0">
                                                    <thead class="thead-light">
                                                        <tr>
                                                            <th>Nome</th>
                                                            <th class="text-center">Horas</th>
                                                            <th>Data</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var mao in Model.MaoDeObra.OrderByDescending(m => m.Data))
                                                        {
                                                            <tr>
                                                                <td><strong>@mao.Nome</strong></td>
                                                                <td class="text-center">
                                                                    <span class="badge badge-info">@mao.Horas.ToString("0.##")h</span>
                                                                </td>
                                                                <td>
                                                                    <i class="far fa-clock mr-1"></i>@mao.Data.ToString("dd/MM/yyyy HH:mm")
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="p-3 text-center text-muted">
                                                <i class="fas fa-info-circle mr-1"></i>Não há registos.
                                            </div>
                                        }

                                    </div>
                                </div>

                            </div>

                            <!-- TAB: Pagamentos -->
                            <div class="tab-pane fade" id="pagamentos" role="tabpanel">

                                <!-- Formulário -->
                                <div class="card card-info">
                                    <div class="card-header">
                                        <h3 class="card-title"><i class="fas fa-plus-circle mr-2"></i>Adicionar Pagamento</h3>
                                    </div>
                                    <div class="card-body">

                                        <form asp-controller="Pagamentos" asp-action="Create" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="Id_Obra" value="@Model.Id_Obra" />

                                            <div class="form-group">
                                                <label><i class="fas fa-user mr-1"></i>Nome</label>
                                                <input type="text" name="NomePessoa" class="form-control" required />
                                            </div>

                                            <div class="form-group">
                                                <label><i class="fas fa-euro-sign mr-1"></i>Valor (€)</label>
                                                <input type="number" name="Valor" step="0.01" class="form-control" required />
                                            </div>

                                            <button class="btn btn-info">
                                                <i class="fas fa-save mr-1"></i> Registar Pagamento
                                            </button>
                                        </form>

                                    </div>
                                </div>

                                <!-- Lista pagamentos -->
                                <div class="card card-primary mt-3">
                                    <div class="card-header">
                                        <h3 class="card-title"><i class="fas fa-list mr-2"></i>Registos de Pagamentos</h3>
                                    </div>
                                    <div class="card-body p-0">

                                        @if (Model.Pagamentos?.Any() == true)
                                        {
                                            <div class="table-responsive">
                                                <table class="table table-striped table-hover mb-0">
                                                    <thead class="thead-light">
                                                        <tr>
                                                            <th>Nome</th>
                                                            <th class="text-right">Valor</th>
                                                            <th>Data</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var pag in Model.Pagamentos.OrderByDescending(p => p.Data))
                                                        {
                                                            <tr>
                                                                <td><strong>@pag.Nome</strong></td>
                                                                <td class="text-right">
                                                                    <span class="badge badge-success">@pag.Valor.ToString("0.00") €</span>
                                                                </td>
                                                                <td>
                                                                    <i class="far fa-clock mr-1"></i>@pag.Data.ToString("dd/MM/yyyy HH:mm")
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="p-3 text-center text-muted">
                                                <i class="fas fa-info-circle mr-1"></i>Não há pagamentos registados.
                                            </div>
                                        }

                                    </div>
                                </div>

                            </div>

                        </div>
                    </div>

                    <!-- Ações -->
                    <div class="card-footer">
                        <a asp-action="Edit" asp-route-id="@Model.Id_Obra" class="btn btn-warning">
                            <i class="fas fa-edit mr-1"></i> Editar
                        </a>

                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left mr-1"></i> Voltar
                        </a>

                        <a asp-action="Delete" asp-route-id="@Model.Id_Obra" class="btn btn-danger float-right">
                            <i class="fas fa-trash-alt mr-1"></i> Apagar
                        </a>
                    </div>

                </div>

            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $(function () {
            // Tabs Bootstrap 4
            $('#obraTabs a[data-toggle="pill"]').on('click', function (e) {
                e.preventDefault();
                $(this).tab('show');
            });

            // Guardar aba ativa no URL
            $('a[data-toggle="pill"]').on('shown.bs.tab', function (e) {
                window.location.hash = e.target.getAttribute('href');
            });

            // Carregar aba ativa do URL
            var hash = window.location.hash;
            if (hash) {
                $('#obraTabs a[href="' + hash + '"]').tab('show');
            }
        });
    </script>
}



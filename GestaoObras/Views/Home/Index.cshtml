@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Dashboard";
}

<!-- Content Header (Page header) -->
<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Dashboard</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item active">Dashboard</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        <!-- Info boxes -->
        <div class="row">
            <!-- Obras Ativas -->
            <div class="col-lg-3 col-6">
                <div class="small-box bg-info">
                    <div class="inner">
                        <h3>15</h3>
                        <p>Obras Ativas</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-building"></i>
                    </div>
                    <a asp-controller="Obras" asp-action="Index" class="small-box-footer">
                        Ver obras <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>

            <!-- Clientes -->
            <div class="col-lg-3 col-6">
                <div class="small-box bg-success">
                    <div class="inner">
                        <h3>5</h3>
                        <p>Clientes</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-users"></i>
                    </div>
                    <a asp-controller="Clientes" asp-action="Index" class="small-box-footer">
                        Ver clientes <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>

            <!-- Alertas de Stock -->
            <div class="col-lg-3 col-6">
                <div class="small-box bg-warning">
                    <div class="inner">
                        <h3>15</h3>
                        <p>Alertas de Stock</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                    <a asp-controller="Materiais" asp-action="Index" class="small-box-footer">
                        Ver materiais <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>

            <!-- Movimentos -->
            <div class="col-lg-3 col-6">
                <div class="small-box bg-danger">
                    <div class="inner">
                        <h3>65</h3>
                        <p>Movimentos</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-exchange-alt"></i>
                    </div>
                    <a asp-controller="Movimentos" asp-action="Index" class="small-box-footer">
                        Ver movimentos <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Recent Activity -->
        <div class="row">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header border-transparent">
                        <h3 class="card-title">
                            <i class="fas fa-clock mr-2"></i>Obras Recentes
                        </h3>
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table m-0">
                                <thead>
                                    <tr>
                                        <th>Obra</th>
                                        <th>Cliente</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>Construção de Moradia</td>
                                        <td>João Ferreira</td>
                                        <td><span class="badge badge-danger">Não</span></td>
                                    </tr>
                                    <tr>
                                        <td>Reabilitação de Prédio</td>
                                        <td>João Ferreira</td>
                                        <td><span class="badge badge-success">Sim</span></td>
                                    </tr>
                                    <tr>
                                        <td>Construção de Pavilhão</td>
                                        <td>Joana Sá</td>
                                        <td><span class="badge badge-success">Sim</span></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="card-footer clearfix">
                        <a asp-controller="Obras" asp-action="Create" class="btn btn-sm btn-primary float-left">
                            <i class="fas fa-plus mr-1"></i> Nova Obra
                        </a>
                        <a asp-controller="Obras" asp-action="Index" class="btn btn-sm btn-secondary float-right">
                            Ver todas <i class="fas fa-arrow-right ml-1"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card">
                    <div class="card-header border-transparent">
                        <h3 class="card-title">
                            <i class="fas fa-exchange-alt mr-2"></i>Movimentos Recentes
                        </h3>
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table m-0">
                                <thead>
                                    <tr>
                                        <th>Material</th>
                                        <th>Operação</th>
                                        <th>Qtd</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>Betão pronto C25/30</td>
                                        <td><span class="badge badge-danger">REMOVE</span></td>
                                        <td>50</td>
                                    </tr>
                                    <tr>
                                        <td>Varão de aço Ø12 mm</td>
                                        <td><span class="badge badge-danger">REMOVE</span></td>
                                        <td>1</td>
                                    </tr>
                                    <tr>
                                        <td>Tijolo térmico 11 cm</td>
                                        <td><span class="badge badge-danger">REMOVE</span></td>
                                        <td>10</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="card-footer clearfix">
                        <a asp-controller="Movimentos" asp-action="Index" class="btn btn-sm btn-secondary float-right">
                            Ver todos <i class="fas fa-arrow-right ml-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="row">
            <div class="col-12">
                <div class="card card-primary card-outline">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-bolt mr-2"></i>Ações Rápidas
                        </h3>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-3 col-sm-6">
                                <a asp-controller="Clientes" asp-action="Create" class="btn btn-app bg-success w-100">
                                    <i class="fas fa-user-plus"></i> Novo Cliente
                                </a>
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <a asp-controller="Obras" asp-action="Create" class="btn btn-app bg-info w-100">
                                    <i class="fas fa-building"></i> Nova Obra
                                </a>
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <a asp-controller="Materiais" asp-action="Create" class="btn btn-app bg-warning w-100">
                                    <i class="fas fa-box-open"></i> Novo Material
                                </a>
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <a asp-controller="Movimentos" asp-action="Index" class="btn btn-app bg-danger w-100">
                                    <i class="fas fa-exchange-alt"></i> Movimentos
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>



